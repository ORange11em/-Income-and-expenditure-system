# คัดลอกเป็น .env และเปลี่ยนค่าตัวอย่างทุกค่า ก่อนเริ่มระบบ; ห้ามส่ง .env เข้า Git หรือแชต
NODE_ENV=production
PORT=3000
# ต้องตรงกับ origin ที่ผู้ใช้เปิดจริง (HTTPS และไม่มี / ท้าย URL)
APP_ORIGIN=https://it-ledger.intra.example.go.th
# Secure cookie ใช้ได้เมื่อมี HTTPS reverse proxy ด้านหน้า
COOKIE_SECURE=true
# PostgreSQL อยู่ใน Docker network เดียวกับแอป; เปิด TLS ที่ proxy และเข้ารหัสดิสก์ของ host
DB_SSL=false
# สุ่มด้วย openssl rand -hex 32; ใช้ hex เพื่อไม่ให้ URI connection string พังจากอักขระพิเศษ
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHAR_RANDOM_VALUE
# ใช้สร้างบัญชี ADMIN ครั้งแรกเท่านั้น แล้วเอารหัสผ่านออกจาก .env หลังล็อกอินสำเร็จ
INITIAL_ADMIN_USERNAME=itadmin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
